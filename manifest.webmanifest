{
  "name": "express music",
  "short_name": "express music",
  "description": "Nokia XpressMusic style web app.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#08090a",
